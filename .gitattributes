# Normalize all text files to LF in the repository and on checkout.
# Prevents CRLF/LF churn when the project is cloned across OSes.
* text=auto eol=lf

# Binary assets — never modify their bytes.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.jar   binary
*.woff  binary
*.woff2 binary
